{
  "compilerOptions": {
    "target": "es5",
    "lib": ["es5", "dom"],
    "types": [
      "cypress",
      "node",
      "@testing-library/cypress"
    ],
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "**/*.ts",
    "../cypress.config.ts",
    "support/*.ts",
    "../node_modules/cypress/types/*.ts"
  ]
}
